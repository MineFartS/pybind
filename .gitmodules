
[submodule ".msys2"]
	path = .msys2
	url = https://github.com/MineFartsEmbed/MSYS2
    ignore = all

[submodule ".pybind11"]
	path = .pybind11
	url = https://github.com/pybind/pybind11
	branch = stable
    ignore = all

[submodule ".python314"]
	path = .python314
	url = https://github.com/MineFartsEmbed/Python
	branch = 3.14.5
    ignore = all

